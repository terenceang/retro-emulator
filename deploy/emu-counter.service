[Unit]
Description=EMU visitor counter (landing page)
After=network.target

[Service]
Type=simple
User=terence
Group=terence
ExecStart=/home/terence/.local/opt/node/bin/node /home/terence/backup-repos/emu-counter/server.mjs
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/terence/backup-repos/emu-counter
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
