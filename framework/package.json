{
  "name": "@retro/framework",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "exports": {
    "./base64": {
      "types": "./src/base64.ts",
      "default": "./src/base64.ts"
    },
    "./idb": {
      "types": "./src/idb.ts",
      "default": "./src/idb.ts"
    },
    "./ring-buffer": {
      "types": "./src/ring-buffer.ts",
      "default": "./src/ring-buffer.ts"
    },
    "./emulator-client": {
      "types": "./src/emulator-client.ts",
